#include <windows.h>
#include "patch-version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
FILEVERSION EU4_MENU_PATCH_FILE_VERSION
PRODUCTVERSION EU4_MENU_PATCH_FILE_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "VulonLok"
            VALUE "FileDescription", "EU4 Menu Patch by VulonLok"
            VALUE "FileVersion", EU4_MENU_PATCH_FILE_VERSION_STRING
            VALUE "ProductName", "EU4 Menu Patch"
            VALUE "ProductVersion", EU4_MENU_PATCH_VERSION
            VALUE "Comments", "Author: VulonLok"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
